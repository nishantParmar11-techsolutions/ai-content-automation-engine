# ==============================================================================
# Enterprise AI Content Automation Engine - Environment Configuration
# ==============================================================================

# API Authentication (Keep secure, never commit real production keys)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-claude-api-key-here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXXXX

# AI Agent Configuration & Hyperparameters
DEFAULT_LLM_PROVIDER=anthropic
PRIMARY_MODEL=claude-3-5-sonnet-20241022
FALLBACK_MODEL=gpt-4o
AGENT_TEMPERATURE=0.3
MAX_RESPONSE_TOKENS=2048

# Operational Settings
NODE_ENV=production
AUTOMATION_TIMEOUT_MS=30000
ENABLE_STRICT_QA_FILTER=True
